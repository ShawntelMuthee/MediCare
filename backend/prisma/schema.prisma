generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id               String                 @id @default(uuid())
  registrationDate DateTime               @default(now())
  firstName        String
  lastName         String
  dateOfBirth      DateTime
  gender           String
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  generalAssess    GeneralAssessment[]
  overweightAssess OverweightAssessment[]
  vitals           Vitals[]

  @@index([lastName, firstName])
  @@index([registrationDate])
}

model Vitals {
  id        String   @id @default(uuid())
  patientId String
  visitDate DateTime @default(now())
  height    Float
  weight    Float
  bmi       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([visitDate])
}

model OverweightAssessment {
  id             String   @id @default(uuid())
  patientId      String
  visitDate      DateTime @default(now())
  generalHealth  String
  everBeenOnDiet Boolean
  comments       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([visitDate])
}

model GeneralAssessment {
  id                  String   @id @default(uuid())
  patientId           String
  visitDate           DateTime @default(now())
  generalHealth       String
  currentlyUsingDrugs Boolean
  comments            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  patient             Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([visitDate])
}
